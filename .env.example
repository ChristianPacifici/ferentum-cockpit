# Copia questo file in .env e compila i valori reali.
# .env NON deve mai essere committato (vedi .gitignore).

# Porta su cui gira l'app principale
PORT=3000

# true = usa il mock-server locale (default, per sviluppo senza credenziali reali)
# false = chiama le vere API di Jira e GitHub
USE_MOCKS=true

# URL del mock server (usato solo quando USE_MOCKS=true)
MOCK_SERVER_URL=http://localhost:4000

# --- Jira ---
# Base URL della tua istanza Atlassian, es: https://tuaazienda.atlassian.net
JIRA_BASE_URL=
# Email dell'account Jira usato per l'autenticazione
JIRA_EMAIL=
# API token generato da https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# JQL usata per la sezione "Da fare" (default: ticket assegnati a te, non completati)
JIRA_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC
# JQL usata per il feed "Attività del team" (default: tutto il progetto FER, più recenti prima)
JIRA_TEAM_JQL=project = FER ORDER BY updated DESC
# Numero massimo di eventi mostrati nel feed "Attività del team"
JIRA_ACTIVITY_LIMIT=10
# JQL per la vista "Carico di lavoro": usa "project in (...)" per aggregare più progetti insieme
JIRA_WORKLOAD_JQL=project in (FER, PLAT) AND statusCategory != Done ORDER BY updated DESC

# --- GitHub ---
# Personal Access Token (fine-grained o classic) con permesso "repo" / "pull_request: read"
GITHUB_TOKEN=
# Il tuo username GitHub, usato per filtrare le PR create da te
GITHUB_USERNAME=
# Elenco repo da monitorare, formato owner/repo separati da virgola (già multi-repo)
GITHUB_REPOS=owner/repo-1,owner/repo-2
# true = mostra solo le PR create da GITHUB_USERNAME, false = tutte le PR aperte dei repo indicati
GITHUB_ONLY_MINE=true

# --- Team & carico di lavoro ---
# Mappa "login GitHub=Nome Jira" separata da virgola, per unire i conteggi delle due fonti per persona
TEAM_DIRECTORY=login1=Nome Cognome,login2=Nome Cognome

# --- CI (GitHub Actions) ---
# true = mostra le build fallite tra i "Segnali di progetto" (usa GITHUB_REPOS/GITHUB_TOKEN sopra)
CI_ENABLED=true

# --- PagerDuty ---
PAGERDUTY_ENABLED=true
PAGERDUTY_BASE_URL=https://api.pagerduty.com
PAGERDUTY_TOKEN=

# --- Slack ---
SLACK_ENABLED=true
SLACK_API_URL=https://slack.com/api
SLACK_TOKEN=
# Query usata per cercare le menzioni, es. "@me" oppure "from:@qualcuno"
SLACK_MENTION_QUERY=@me
